# Copy to .env and fill in. .env is gitignored — never commit secrets.

GEMINI_API_KEY=

DATABASE_URL=postgresql://app:app@localhost:5432/app
GROBID_URL=http://localhost:8070
OLLAMA_URL=http://localhost:11434

# CLAUDE.md DEVIATION-2: this project lives inside OneDrive. Model weights and
# LLM caches are multi-GB and will be sync-thrashed if kept in the repo tree.
# Point them at local-only storage.
HF_HOME=C:/Users/saivi/AppData/Local/nlp_project/hf
LLM_CACHE_DIR=C:/Users/saivi/AppData/Local/nlp_project/llm_cache
# Windows without Developer Mode cannot symlink; HF falls back to copies. Silence the warning.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# hf_xet download backend stalled at 0 bytes on a 3.1 GB checkpoint (2026-10-29); plain HTTPS did it in 100 s.
HF_HUB_DISABLE_XET=1
